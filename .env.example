DB_NAME=vertice
DB_USERNAME=vertice
DB_PASSWORD=vertice

BFF_LOG_LEVEL=info
# Browser origins allowed to call the BFF directly (comma-separated). Only Expo web
# (vertice-mobile) does; vertice-web-react proxies server-side and needs no CORS.
CORS_ORIGIN=http://localhost:8081
# Shared dev secret: the same value is vertice-api's and vertice-bff's dev default, so tokens
# the bff mints verify at the api. Never use it outside local dev (both services refuse it).
JWT_SECRET=vertice-dev-jwt-secret-do-not-use-in-production
JWT_EXPIRES_IN=8h
