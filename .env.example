DB_NAME=vertice
DB_USERNAME=vertice
DB_PASSWORD=vertice

BFF_LOG_LEVEL=info
# Browser origins allowed to call the BFF directly (comma-separated). Only Expo web
# (vertice-mobile) does; vertice-web-react proxies server-side and needs no CORS.
CORS_ORIGIN=http://localhost:8081
# Required. Shared by bff (signs tokens) and api (verifies them). The api runs with auth on, which
# refuses the public dev placeholder, so generate your own (>= 32 bytes) once:
#   echo "JWT_SECRET=$(openssl rand -base64 48)" >> .env
JWT_SECRET=
# Spring profiles for the api. Empty = auth on (default). Set to `local` only to debug with grpcurl
# or Postman without tokens (no gRPC auth, reflection on).
API_PROFILES=
JWT_EXPIRES_IN=8h
